# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=videos-temp

# yt-dlp: ruta al archivo cookies.txt (formato Netscape) con una sesión
# de Instagram exportada. Necesario porque Instagram bloquea descargas
# anónimas. Expórtalo con una extensión de navegador (ej. "Get cookies.txt
# LOCALLY") estando logueado en Instagram, y vuelve a exportarlo cuando
# caduque la sesión. Ruta relativa a la raíz del proyecto.
INSTAGRAM_COOKIES_FILE=cookies.txt

